# AV Treasury DApp Configuration
# Copy to .env.local and fill in your keys

# Coinbase Wallet Project ID (from https://portal.cbp.coinbase.com/)
# NEXT_PUBLIC_WALLET_PROJECT_ID=

# 0x API Key (optional, for swap aggregation)
# NEXT_PUBLIC_ZEROX_API_KEY=

# 1inch API Key (optional, for swap aggregation)
# NEXT_PUBLIC_1INCH_API_KEY=

# BaseScan API Key (optional, for contract verification)
# NEXT_PUBLIC_BASESCAN_API_KEY=

# RPC URL Override (defaults to public Base RPC)
# NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
